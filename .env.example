# Application Configuration
APP_NAME="Nexus RAG - Enterprise Assistant"
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security & Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY=enterprise_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./data/rag_assistant.db
UPLOAD_DIR=./data/uploads

# LLM Providers (Configure one or allow users to input their key in the UI settings)
# Gemini API Key (Recommended - Free tier available from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Groq API Key (Optional, ultra-fast inference from https://console.groq.com/)
GROQ_API_KEY=

# Default Provider: "gemini", "openai", "groq", or "smart_local" (works offline without any API key)
DEFAULT_LLM_PROVIDER=smart_local

# Embedding Provider: "local_dense" (no API key needed, zero-cost), "gemini", or "openai"
DEFAULT_EMBEDDING_PROVIDER=local_dense

# RAG Configuration
CHUNK_SIZE=700
CHUNK_OVERLAP=150
TOP_K_RESULTS=4
